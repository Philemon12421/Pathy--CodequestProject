{
  "expo": {
    "name": "Pathy",
    "slug": "safetrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.safetrack.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.safetrack.mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSy_Pathy_Mobile_Maps_Config_Key"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      "expo-av",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Pathy to access your microphone for voice commands.",
          "speechRecognitionPermission": "Allow Pathy to use speech recognition for voice input."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7666784f-f4bb-4764-ab27-b76d9a18f3d2"
      }
    }
  }
}
